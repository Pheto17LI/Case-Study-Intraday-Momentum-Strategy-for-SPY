def max_drawdown_from_aum(aum):
    x = aum.dropna().astype(float)
    if x.empty:
        return np.nan
    # Include the initial capital so a loss on the first backtest day is captured.
    x = pd.concat([pd.Series([AUM_0], index=["Initial"]), x])
    running_max = x.cummax()
    dd = x / running_max - 1.0
    return -dd.min() * 100.0


def portfolio_stats(name, stop_label, size_label, result, spy_ret):
    r = result["ret"].dropna().astype(float)
    if r.empty:
        return {}

    total_return = ((1.0 + r).prod() - 1.0) * 100.0
    irr = ((1.0 + r).prod() ** (252.0 / len(r)) - 1.0) * 100.0
    vol = r.std(ddof=1) * np.sqrt(252.0) * 100.0
    sharpe = (r.mean() / r.std(ddof=1) * np.sqrt(252.0)) if r.std(ddof=1) != 0 else np.nan
    active = r[r != 0]
    hit = (active > 0).mean() * 100.0 if len(active) else np.nan
    mdd = max_drawdown_from_aum(result.loc[r.index, "AUM"])

    spy = spy_ret.reindex(r.index)
    common = pd.concat([r.rename("strategy"), spy.rename("spy")], axis=1).dropna()
    alpha = np.nan
    beta = np.nan
    if len(common) > 5 and common["spy"].std(ddof=1) != 0:
        model = sm.OLS(common["strategy"], sm.add_constant(common["spy"])).fit()
        alpha = model.params["const"] * 252.0 * 100.0
        beta = model.params["spy"]

    skewness = r.skew()
    worst_day = r.min() * 100.0
    best_day = r.max() * 100.0

    return {
        "Strategy": name,
        "Stop": stop_label,
        "Size": size_label,
        "Total Return (%)": total_return,
        "IRR (%)": irr,
        "Vol (%)": vol,
        "Sharpe Ratio": sharpe,
        "Hit Ratio (%)": hit,
        "MDD (%)": mdd,
        "Alpha (%)": alpha,
        "Beta": beta,
        "Skewness": skewness,
        "Worst Day (%)": worst_day,
        "Best Day (%)": best_day,
    }


def trade_stats(name, stop_label, size_label, trades, n_days):
    if trades is None or trades.empty:
        return {
            "Strategy": name, "Stop": stop_label, "Size": size_label,
            "Trades": 0, "Avg. Trade x Day": 0.0, "Hit Ratio (%)": np.nan,
            "Avg. PnL x Share ($)": np.nan, "Max Loss Trade (%)": np.nan,
            "Max Loss Date": "", "Max Gain Trade (%)": np.nan, "Max Gain Date": "",
        }

    worst_idx = trades["Trade Return (%)"].idxmin()
    best_idx = trades["Trade Return (%)"].idxmax()
    worst = trades.loc[worst_idx]
    best = trades.loc[best_idx]

    return {
        "Strategy": name,
        "Stop": stop_label,
        "Size": size_label,
        "Trades": int(len(trades)),
        "Avg. Trade x Day": len(trades) / n_days if n_days else np.nan,
        "Hit Ratio (%)": (trades["Gross PnL / Share"] > 0).mean() * 100.0,
        "Avg. PnL x Share ($)": trades["Gross PnL / Share"].mean(),
        "Max Loss Trade (%)": worst["Trade Return (%)"],
        "Max Loss Date": pd.Timestamp(worst["Day"]).strftime("%d-%b-%Y"),
        "Max Gain Trade (%)": best["Trade Return (%)"],
        "Max Gain Date": pd.Timestamp(best["Day"]).strftime("%d-%b-%Y"),
    }

def annual_returns(return_series):
    s = return_series.dropna().copy()
    idx = pd.to_datetime(s.index.astype(str))
    s.index = idx
    return ((1.0 + s).groupby(s.index.year).prod() - 1.0) * 100.0


def monthly_table(return_series):
    s = return_series.dropna().copy()
    s.index = pd.to_datetime(s.index.astype(str))
    monthly = ((1.0 + s).groupby([s.index.year, s.index.month]).prod() - 1.0) * 100.0
    tbl = monthly.unstack(level=1)
    tbl = tbl.reindex(columns=range(1, 13))
    tbl.columns = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"]
    yearly = ((1.0 + s).groupby(s.index.year).prod() - 1.0) * 100.0
    tbl["Yearly"] = yearly
    tbl.index.name = "Year"
    return tbl



