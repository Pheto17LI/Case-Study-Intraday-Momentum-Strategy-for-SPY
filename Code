def current_band_vwap_exposure(day_data, ub, lb):
    """Paper's current-band + VWAP stop logic, checked every 30 minutes."""
    close = day_data["close"].to_numpy()
    vwap = day_data["vwap"].to_numpy()
    ubv = ub.to_numpy() if isinstance(ub, pd.Series) else np.asarray(ub)
    lbv = lb.to_numpy() if isinstance(lb, pd.Series) else np.asarray(lb)

    raw_signal = np.zeros(len(day_data), dtype=float)
    raw_signal[(close > ubv) & (close > vwap)] = 1.0
    raw_signal[(close < lbv) & (close < vwap)] = -1.0

    trade_idx = np.where(day_data["min_from_open"].to_numpy() % TRADE_FREQ_MIN == 0)[0]
    decision = np.full(len(day_data), np.nan)
    decision[trade_idx] = raw_signal[trade_idx]

    last_valid = np.nan
    filled = []
    for value in decision:
        if not np.isnan(value):
            last_valid = value
        if last_valid == 0:
            last_valid = np.nan
        filled.append(last_valid)

    # Signal is observed on the completed minute; position applies to the next minute return.
    return pd.Series(filled, index=day_data.index).shift(1).fillna(0.0).to_numpy()


def opposite_band_exposure(day_data, ub, lb):
    """Base strategy: once entered, hold until the opposite Noise Area band is crossed."""
    close = day_data["close"].to_numpy()
    ubv = ub.to_numpy() if isinstance(ub, pd.Series) else np.asarray(ub)
    lbv = lb.to_numpy() if isinstance(lb, pd.Series) else np.asarray(lb)

    trade_idx = np.where(day_data["min_from_open"].to_numpy() % TRADE_FREQ_MIN == 0)[0]
    decision = np.full(len(day_data), np.nan)
    state = 0.0

    for i in trade_idx:
        if state == 0:
            if close[i] > ubv[i]:
                state = 1.0
            elif close[i] < lbv[i]:
                state = -1.0
        elif state > 0:
            if close[i] < lbv[i]:
                state = -1.0
        else:
            if close[i] > ubv[i]:
                state = 1.0
        decision[i] = state

    # Forward fill state between semi-hourly checks.
    series = pd.Series(decision, index=day_data.index).ffill().fillna(0.0)
    return series.shift(1).fillna(0.0).to_numpy()


def extract_trade_records(day_data, exposure, strategy_name, day, shares):
    """Convert minute exposure into round-trip trade records for audit / paper-style trade table."""
    close = day_data["close"].to_numpy(dtype=float)
    timestamps = day_data.index.to_numpy()
    records = []

    if len(close) < 2:
        return records

    start_i = None
    direction = 0.0

    for i in range(1, len(exposure)):
        exp_i = float(exposure[i])
        exp_prev = float(exposure[i - 1])

        # Start or reversal: exposure at i earns close[i]-close[i-1], so entry is close[i-1].
        if exp_i != 0 and exp_i != exp_prev:
            if exp_prev != 0 and start_i is not None:
                exit_idx = i - 1
                entry_price = close[start_i - 1]
                exit_price = close[exit_idx]
                pnl_per_share = direction * (exit_price - entry_price)
                ret_pct = direction * (exit_price / entry_price - 1.0) * 100.0
                records.append({
                    "Strategy": strategy_name,
                    "Day": day,
                    "Direction": "Long" if direction > 0 else "Short",
                    "Entry Time": pd.Timestamp(timestamps[start_i - 1]),
                    "Exit Time": pd.Timestamp(timestamps[exit_idx]),
                    "Entry Price": entry_price,
                    "Exit Price": exit_price,
                    "Gross PnL / Share": pnl_per_share,
                    "Trade Return (%)": ret_pct,
                    "Shares": shares,
                })
            start_i = i
            direction = exp_i

        # Exit to flat.
        elif exp_i == 0 and exp_prev != 0 and start_i is not None:
            exit_idx = i - 1
            entry_price = close[start_i - 1]
            exit_price = close[exit_idx]
            pnl_per_share = direction * (exit_price - entry_price)
            ret_pct = direction * (exit_price / entry_price - 1.0) * 100.0
            records.append({
                "Strategy": strategy_name,
                "Day": day,
                "Direction": "Long" if direction > 0 else "Short",
                "Entry Time": pd.Timestamp(timestamps[start_i - 1]),
                "Exit Time": pd.Timestamp(timestamps[exit_idx]),
                "Entry Price": entry_price,
                "Exit Price": exit_price,
                "Gross PnL / Share": pnl_per_share,
                "Trade Return (%)": ret_pct,
                "Shares": shares,
            })
            start_i = None
            direction = 0.0

    # Force any open position out at the market close (last regular-hours close).
    if exposure[-1] != 0 and start_i is not None:
        entry_price = close[start_i - 1]
        exit_price = close[-1]
        pnl_per_share = direction * (exit_price - entry_price)
        ret_pct = direction * (exit_price / entry_price - 1.0) * 100.0
        records.append({
            "Strategy": strategy_name,
            "Day": day,
            "Direction": "Long" if direction > 0 else "Short",
            "Entry Time": pd.Timestamp(timestamps[start_i - 1]),
            "Exit Time": pd.Timestamp(timestamps[-1]),
            "Entry Price": entry_price,
            "Exit Price": exit_price,
            "Gross PnL / Share": pnl_per_share,
            "Trade Return (%)": ret_pct,
            "Shares": shares,
        })

    return records


