def fetch_alpaca_data(ticker, start_date, end_date, period, feed="sip"):
    """Fetch 1-minute or 1-day bars and return paper-compatible columns."""
    timeframe = {"minute": "1Min", "day": "1Day"}.get(period)
    if timeframe is None:
        raise ValueError("period must be 'minute' or 'day'")

    url = f"{ALPACA_BASE_URL}/v2/stocks/{ticker}/bars"
    params = {
        "timeframe": timeframe,
        "start": start_date,
        "end": end_date,
        "limit": 10000,
        "adjustment": "raw",
        "feed": feed,
        "sort": "asc",
    }

    all_data = []
    page_token = None
    request_number = 0

    while True:
        if page_token is not None:
            params["page_token"] = page_token
        else:
            params.pop("page_token", None)

        response = requests.get(url, headers=HEADERS, params=params, timeout=60)

        if response.status_code == 429:
            retry_after = response.headers.get("Retry-After")
            wait_time = int(retry_after) if retry_after else 10
            print(f"Alpaca rate limit reached. Waiting {wait_time} seconds...")
            time.sleep(wait_time)
            continue

        if response.status_code != 200:
            print("\nALPACA REQUEST FAILED")
            print("HTTP status:", response.status_code)
            try:
                print("Response:", response.json())
            except Exception:
                print("Response:", response.text[:2000])
            raise RuntimeError(f"Alpaca API failed with HTTP {response.status_code}")

        data = response.json()
        bars = data.get("bars", [])
        request_number += 1
        print(f"Request {request_number}: Fetched {len(bars):,} {period} bars.")

        for entry in bars:
            ts = pd.Timestamp(entry["t"])
            if ts.tzinfo is None:
                ts = ts.tz_localize("UTC")
            else:
                ts = ts.tz_convert("UTC")
            eastern_time = ts.tz_convert("America/New_York")
            caldt = eastern_time.tz_localize(None)

            row = {
                "volume": entry["v"],
                "open": entry["o"],
                "high": entry["h"],
                "low": entry["l"],
                "close": entry["c"],
                "caldt": caldt,
            }

            if period == "minute":
                t = eastern_time.time()
                if datetime.strptime("09:30", "%H:%M").time() <= t <= datetime.strptime("15:59", "%H:%M").time():
                    all_data.append(row)
            else:
                all_data.append(row)

        page_token = data.get("next_page_token")
        if not page_token:
            break

    df = pd.DataFrame(all_data)
    if df.empty:
        raise RuntimeError(f"No Alpaca {period} data returned for {ticker} from {start_date} to {end_date}.")

    df = (
        df.sort_values("caldt")
          .drop_duplicates(subset="caldt", keep="last")
          .reset_index(drop=True)
    )

    print(f"{period.capitalize()} data complete: {len(df):,} observations.")

    if period == "minute":
        tmp = df.copy()
        tmp["day"] = pd.to_datetime(tmp["caldt"]).dt.date
        bars_per_day = tmp.groupby("day").size()
        print(
            "Regular-hours bars/day: "
            f"median={bars_per_day.median():.0f}, min={bars_per_day.min()}, max={bars_per_day.max()}"
        )

    return df


def fetch_alpaca_dividends(ticker, start_date, end_date):
    """Fetch cash dividends, returning caldt and dividend."""
    url = f"{ALPACA_BASE_URL}/v1/corporate-actions"
    params = {
        "symbols": ticker,
        "types": "cash_dividend",
        "start": start_date,
        "end": end_date,
        "limit": 1000,
        "sort": "asc",
    }

    rows = []
    page_token = None

    while True:
        if page_token:
            params["page_token"] = page_token
        else:
            params.pop("page_token", None)

        response = requests.get(url, headers=HEADERS, params=params, timeout=60)

        if response.status_code == 429:
            retry_after = response.headers.get("Retry-After")
            wait_time = int(retry_after) if retry_after else 10
            print(f"Dividend API rate limit. Waiting {wait_time} seconds...")
            time.sleep(wait_time)
            continue

        if response.status_code != 200:
            print("\nDIVIDEND REQUEST FAILED")
            print("HTTP status:", response.status_code)
            try:
                print("Response:", response.json())
            except Exception:
                print("Response:", response.text[:2000])
            raise RuntimeError("Alpaca dividend request failed.")

        data = response.json()
        for entry in data.get("cash_dividends", []):
            ex_date = entry.get("ex_date")
            rate = entry.get("rate")
            if ex_date is not None and rate is not None:
                rows.append({
                    "caldt": datetime.strptime(ex_date, "%Y-%m-%d"),
                    "dividend": float(rate),
                })

        page_token = data.get("next_page_token")
        if not page_token:
            break

    out = pd.DataFrame(rows, columns=["caldt", "dividend"])
    print(f"Fetched {len(out)} cash dividends.")
    return out


