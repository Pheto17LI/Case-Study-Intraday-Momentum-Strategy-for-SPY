def load_optional_vix():
    candidates = [Path.home()/"Downloads"/"VIX_History.csv", Path.home()/"Downloads"/"VIX.xlsx", Path.home()/"Downloads"/"VIX.csv", Path.home()/"Downloads"/"vix.xlsx", Path.home()/"Downloads"/"vix.csv"]
    for p in candidates:
        if not p.exists():
            continue
        try:
            raw = pd.read_excel(p) if p.suffix.lower() == ".xlsx" else pd.read_csv(p)
            cols = {str(c).strip().upper(): c for c in raw.columns}
            if "DATE" in cols and "OPEN" in cols:
                out = raw[[cols["DATE"], cols["OPEN"]]].copy()
                out.columns = ["Date", "VIX_Open"]
            elif raw.shape[1] >= 1:
                lines = raw.iloc[:,0].astype(str)
                rows = [x.split(",") for x in lines]
                if rows and rows[0][0].strip().upper() == "DATE":
                    header = [z.strip().upper() for z in rows[0]]
                    vals = pd.DataFrame(rows[1:], columns=header)
                else:
                    # Header may have been interpreted as the Excel column name.
                    header = [z.strip().upper() for z in str(raw.columns[0]).split(",")]
                    vals = pd.DataFrame(rows, columns=header)
                out = vals[["DATE", "OPEN"]].copy()
                out.columns = ["Date", "VIX_Open"]
            else:
                continue
            out["Date"] = pd.to_datetime(out["Date"], errors="coerce").dt.date
            out["VIX_Open"] = pd.to_numeric(out["VIX_Open"], errors="coerce")
            out = out.dropna().drop_duplicates("Date")
            print(f"Loaded optional VIX data from: {p}")
            return out
        except Exception as e:
            print(f"Could not parse optional VIX file {p}: {e}")
    return None


