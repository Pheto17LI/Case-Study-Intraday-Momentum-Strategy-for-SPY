    except ImportError:
        print("\nExcel export skipped because openpyxl is not installed.")

    readme=f"""SPY INTRADAY MOMENTUM - CLEANED COMPARISON\n\nSample: {FROM_DATE} to {UNTIL_DATE}\nData: Alpaca {FEED.upper()}\nCommission: ${COMMISSION_PER_SHARE}/share, minimum ${MIN_COMMISSION_PER_ORDER}/order\nSlippage: ${SLIPPAGE_PER_SHARE}/share\n\nRETAINED STRATEGIES\n- Opposite Band 1x\n- Current Band + VWAP 1x\n- Current Band + VWAP Dynamic\n- Maroy (2025) VWAP #1 published-parameter SPY adaptation\n- OWN v2 Adaptive Noise + Adaptive Stop\n- SPY Buy & Hold\n\nCHRONOLOGICAL SPLIT\n- TRAIN: {SPLIT_TRAIN_START} to {SPLIT_TRAIN_END}\n- VALIDATION: {SPLIT_VALIDATION_START} to {SPLIT_VALIDATION_END}\n- TEST: {SPLIT_TEST_START} to {SPLIT_TEST_END}\n\nOWN v2\n- Dynamically blends 2-day and 14-day same-minute Noise Area estimates.\n- Uses the fast/slow divergence score to choose VWAP-only vs adaptive-band+VWAP stop.\n- q_regime selected on validation only: {own2_threshold:.2f}.\n"""
    (OUTPUT_DIR/"00_README_RESULTS.txt").write_text(readme)

    files=sorted([p for p in OUTPUT_DIR.rglob("*") if p.is_file() and "cache" not in p.parts])
    manifest=pd.DataFrame({"File":[str(p.relative_to(OUTPUT_DIR)) for p in files],"Type":[p.suffix.lower().lstrip(".") for p in files]})
    manifest.to_csv(OUTPUT_DIR/"00_OUTPUT_MANIFEST.csv",index=False)
    (OUTPUT_DIR/"00_OUTPUT_MANIFEST.txt").write_text("\n".join(manifest["File"].tolist()))
    zip_path=OUTPUT_DIR/"SPY_Paper_Replication_All_Outputs.zip"
    with zipfile.ZipFile(zip_path,"w",compression=zipfile.ZIP_DEFLATED) as zf:
        for pth in sorted(OUTPUT_DIR.rglob("*")):
            if not pth.is_file() or "cache" in pth.parts or pth==zip_path: continue
            zf.write(pth,arcname=str(pth.relative_to(OUTPUT_DIR)))

    print(f"\nEquity graph exported: {graph_path}")
    print(f"Tables: {TABLE_DIR}")
    print(f"Figures: {FIGURE_DIR}")
    print(f"Data: {DATA_DIR}")
    print(f"ZIP: {zip_path}")


