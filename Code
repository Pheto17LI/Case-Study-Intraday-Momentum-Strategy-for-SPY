def stats_for_subset(r):
    r = pd.Series(r).dropna().astype(float)
    n = len(r)
    if n == 0:
        return {"Observations": 0, "Avg.PnL (bps)": np.nan, "t-stat": np.nan, "Hit Ratio (%)": np.nan, "Sharpe Ratio": np.nan}
    sd = r.std(ddof=1)
    tstat = r.mean() / (sd / np.sqrt(n)) if n > 1 and sd > 0 else np.nan
    active = r[r != 0]
    hit = (active > 0).mean() * 100 if len(active) else np.nan
    sharpe = r.mean() / sd * np.sqrt(252) if sd > 0 else np.nan
    return {"Observations": n, "Avg.PnL (bps)": r.mean()*10000, "t-stat": tstat, "Hit Ratio (%)": hit, "Sharpe Ratio": sharpe}


