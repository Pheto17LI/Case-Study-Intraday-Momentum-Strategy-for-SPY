def drawdown_series(aum):
    x = aum.astype(float).copy()
    x = x.ffill()
    running_max = x.cummax()
    return (x / running_max - 1.0) * 100.0


def rolling_sharpe(return_series, window=252):
    s = return_series.astype(float).copy()
    mu = s.rolling(window, min_periods=max(60, window // 2)).mean()
    sd = s.rolling(window, min_periods=max(60, window // 2)).std(ddof=1)
    return mu / sd * np.sqrt(252.0)


