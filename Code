def run_strategy(df, daily, all_days, strategy_name, stop_type, sizing_type, band_mult=BAND_MULT, commission_per_share=COMMISSION_PER_SHARE, slippage_per_share=SLIPPAGE_PER_SHARE):
    groups = df.groupby("day")
    out = pd.DataFrame(index=all_days)
    out.index.name = "Day"
    out["ret"] = np.nan
    out["AUM"] = np.nan
    out["orders"] = 0
    out["shares"] = np.nan
    out["leverage"] = np.nan

    current_aum = AUM_0
    trade_records = []

    for d, current_day in enumerate(all_days):
        out.loc[current_day, "AUM"] = current_aum

        if d == 0 or current_day not in groups.groups or all_days[d - 1] not in groups.groups:
            continue

        day_data = groups.get_group(current_day)
        prev_data = groups.get_group(all_days[d - 1])

        if day_data["sigma_open"].isna().all():
            continue

        # Use a common warm-up so the three strategies are compared over the same days.
        spx_vol = day_data["spy_dvol"].iloc[0]
        if pd.isna(spx_vol):
            continue

        prev_close_adjusted = prev_data["close"].iloc[-1] - day_data["dividend"].iloc[0]
        open_price = day_data["open"].iloc[0]
        sigma_open = day_data["sigma_open"]

        ub = max(open_price, prev_close_adjusted) * (1.0 + band_mult * sigma_open)
        lb = min(open_price, prev_close_adjusted) * (1.0 - band_mult * sigma_open)

        if stop_type == "opposite_band":
            exposure = opposite_band_exposure(day_data, ub, lb)
        elif stop_type == "current_band_vwap":
            exposure = current_band_vwap_exposure(day_data, ub, lb)
        else:
            raise ValueError("Unknown stop_type")

        if sizing_type == "full_notional":
            leverage = 1.0
        elif sizing_type == "vol_target":
            leverage = min(TARGET_DAILY_VOL / spx_vol, MAX_LEVERAGE)
        else:
            raise ValueError("Unknown sizing_type")

        shares = round(current_aum / open_price * leverage)
        out.loc[current_day, "shares"] = shares
        out.loc[current_day, "leverage"] = leverage

        close = day_data["close"]
        change_1m = close.diff().to_numpy(dtype=float)
        gross_pnl = np.nansum(exposure * change_1m) * shares

        # Each unit of absolute exposure change is one order; reversal counts as two orders.
        orders = int(np.sum(np.abs(np.diff(np.append(exposure, 0.0)))))
        commission_paid = orders * max(MIN_COMMISSION_PER_ORDER, commission_per_share * shares)
        slippage_paid = orders * slippage_per_share * shares
        net_pnl = gross_pnl - commission_paid - slippage_paid

        daily_ret = net_pnl / current_aum if current_aum != 0 else np.nan
        current_aum += net_pnl

        out.loc[current_day, "ret"] = daily_ret
        out.loc[current_day, "AUM"] = current_aum
        out.loc[current_day, "orders"] = orders

        trade_records.extend(extract_trade_records(day_data, exposure, strategy_name, current_day, shares))

    return out, pd.DataFrame(trade_records)


def return_stats_for_period(result, start_date, end_date):
    idx = pd.to_datetime(result.index.astype(str))
    mask = (idx >= pd.Timestamp(start_date)) & (idx <= pd.Timestamp(end_date))
    r = result.loc[mask, "ret"].dropna().astype(float)
    if r.empty:
        return {"Observations": 0, "Total Return (%)": np.nan, "IRR (%)": np.nan,
                "Vol (%)": np.nan, "Sharpe Ratio": np.nan, "Hit Ratio (%)": np.nan,
                "MDD (%)": np.nan}
    aum = AUM_0 * (1.0 + r).cumprod()
    sd = r.std(ddof=1)
    return {
        "Observations": len(r),
        "Total Return (%)": ((1.0 + r).prod() - 1.0) * 100.0,
        "IRR (%)": ((1.0 + r).prod() ** (252.0 / len(r)) - 1.0) * 100.0,
        "Vol (%)": sd * np.sqrt(252.0) * 100.0,
        "Sharpe Ratio": r.mean() / sd * np.sqrt(252.0) if sd > 0 else np.nan,
        "Hit Ratio (%)": (r[r != 0] > 0).mean() * 100.0 if (r != 0).any() else np.nan,
        "MDD (%)": max_drawdown_from_aum(aum),
    }


