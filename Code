# 4D. IMPROVED OWN STRATEGY - ADAPTIVE NOISE + ADAPTIVE STOP
# ============================================================

def adaptive_noise_stop_exposure(day_data, ub, lb, regime_threshold):
    """
    Own v2 strategy.

    1) Entry boundary uses sigma_adaptive: a dynamic blend of the 2-day and 14-day
       same-minute Noise Area estimates.
    2) Every valid adaptive breakout is taken; there is no ML entry filter.
    3) Stop mode is determined by the observable fast-vs-slow regime-change score:
         score >= threshold -> VWAP-only stop (give a changing regime more room)
         score <  threshold -> current adaptive band + VWAP stop
    4) Decisions/stops remain at the paper's 30-minute schedule.
    """
    close = day_data["close"].to_numpy(dtype=float)
    vwap = day_data["vwap"].to_numpy(dtype=float)
    ubv = ub.to_numpy(dtype=float)
    lbv = lb.to_numpy(dtype=float)
    score = day_data["noise_regime_score"].to_numpy(dtype=float)

    long_entry = (close > ubv) & (close > vwap)
    short_entry = (close < lbv) & (close < vwap)
    trade_idx = np.where(day_data["min_from_open"].to_numpy() % TRADE_FREQ_MIN == 0)[0]

    decision = np.full(len(day_data), np.nan)
    state = 0.0
    loose_vwap_only = False

    def choose_loose(i):
        x = score[i]
        return bool(np.isfinite(x) and x >= regime_threshold)

    for i in trade_idx:
        c = float(close[i])
        vw = float(vwap[i])

        if state == 0.0:
            if long_entry[i]:
                state = 1.0
                loose_vwap_only = choose_loose(i)
            elif short_entry[i]:
                state = -1.0
                loose_vwap_only = choose_loose(i)

        elif state > 0:
            if c <= vw:
                if short_entry[i]:
                    state = -1.0
                    loose_vwap_only = choose_loose(i)
                else:
                    state = 0.0
                    loose_vwap_only = False
            elif (not loose_vwap_only) and c <= float(ubv[i]):
                state = 0.0
                loose_vwap_only = False

        else:
            if c >= vw:
                if long_entry[i]:
                    state = 1.0
                    loose_vwap_only = choose_loose(i)
                else:
                    state = 0.0
                    loose_vwap_only = False
            elif (not loose_vwap_only) and c >= float(lbv[i]):
                state = 0.0
                loose_vwap_only = False

        decision[i] = state

    series = pd.Series(decision, index=day_data.index).ffill().fillna(0.0)
    return series.shift(1).fillna(0.0).to_numpy()


def run_adaptive_noise_stop_strategy(df, daily, all_days, regime_threshold,
                                     strategy_name=OWN2_NAME):
    """Backtest the improved own strategy with paper dynamic sizing."""
    groups = df.groupby("day")
    out = pd.DataFrame(index=all_days)
    out.index.name = "Day"
    out["ret"] = np.nan
    out["AUM"] = np.nan
    out["orders"] = 0
    out["shares"] = np.nan
    out["leverage"] = np.nan
    out["noise_regime_threshold"] = regime_threshold

    current_aum = AUM_0
    trade_records = []

    for d, current_day in enumerate(all_days):
        out.loc[current_day, "AUM"] = current_aum
        if d == 0 or current_day not in groups.groups or all_days[d - 1] not in groups.groups:
            continue

        day_data = groups.get_group(current_day)
        prev_data = groups.get_group(all_days[d - 1])
        if day_data["sigma_adaptive"].isna().all():
            continue
        spx_vol = day_data["spy_dvol"].iloc[0]
        if pd.isna(spx_vol):
            continue

        prev_close_adjusted = prev_data["close"].iloc[-1] - day_data["dividend"].iloc[0]
        open_price = float(day_data["open"].iloc[0])
        sigma = day_data["sigma_adaptive"]
        ub = max(open_price, prev_close_adjusted) * (1.0 + BAND_MULT * sigma)
        lb = min(open_price, prev_close_adjusted) * (1.0 - BAND_MULT * sigma)

        exposure = adaptive_noise_stop_exposure(day_data, ub, lb, regime_threshold)
        leverage = min(TARGET_DAILY_VOL / float(spx_vol), MAX_LEVERAGE)
        shares = round(current_aum / open_price * leverage)

        change_1m = day_data["close"].diff().to_numpy(dtype=float)
        gross_pnl = np.nansum(exposure * change_1m) * shares
        orders = int(np.sum(np.abs(np.diff(np.append(exposure, 0.0)))))
        commission_paid = orders * max(MIN_COMMISSION_PER_ORDER, COMMISSION_PER_SHARE * shares)
        slippage_paid = orders * SLIPPAGE_PER_SHARE * shares
        net_pnl = gross_pnl - commission_paid - slippage_paid
        daily_ret = net_pnl / current_aum if current_aum != 0 else np.nan
        current_aum += net_pnl

        out.loc[current_day, "ret"] = daily_ret
        out.loc[current_day, "AUM"] = current_aum
        out.loc[current_day, "orders"] = orders
        out.loc[current_day, "shares"] = shares
        out.loc[current_day, "leverage"] = leverage
        trade_records.extend(extract_trade_records(day_data, exposure, strategy_name, current_day, shares))

    return out, pd.DataFrame(trade_records)


def choose_adaptive_noise_threshold(df, daily, all_days):
    """Choose only the regime-score stop cutoff on 2021 VALIDATION."""
    rows, result_cache, trade_cache = [], {}, {}
    for q in OWN2_REGIME_THRESHOLDS:
        res, trades = run_adaptive_noise_stop_strategy(
            df, daily, all_days, q,
            strategy_name=f"{OWN2_NAME} q={q:.2f}",
        )
        st = return_stats_for_period(res, SPLIT_VALIDATION_START, SPLIT_VALIDATION_END)
        rows.append({"Regime Score Threshold": q, **st})
        result_cache[q] = res
        trade_cache[q] = trades

    tuning = pd.DataFrame(rows)
    eligible = tuning.dropna(subset=["Sharpe Ratio"]).copy()
    if eligible.empty:
        chosen_q = 0.30
    else:
        best = eligible.sort_values(
            ["Sharpe Ratio", "IRR (%)", "MDD (%)"],
            ascending=[False, False, True],
        ).iloc[0]
        chosen_q = float(best["Regime Score Threshold"])
    return chosen_q, tuning, result_cache[chosen_q], trade_cache[chosen_q]


