def prepare_maroy_features(df, daily):
    """Create Maroy-specific 2-day same-minute Noise Area and 2-day realized vol."""
    work = df.copy()
    work["maroy_sigma"] = work.groupby("minute_of_day")["move_open"].transform(
        lambda x: x.shift(1).rolling(
            window=MAROY_LOOKBACK_DAYS,
            min_periods=MAROY_LOOKBACK_DAYS,
        ).mean()
    )

    d = daily.copy().sort_index()
    # Current-day sizing uses only completed prior-day returns.
    d["maroy_dvol"] = d["ret"].shift(1).rolling(
        window=MAROY_LOOKBACK_DAYS,
        min_periods=MAROY_LOOKBACK_DAYS,
    ).std(ddof=1)
    return work, d["maroy_dvol"].to_dict()


def _order_cost(shares):
    shares = int(abs(shares))
    if shares <= 0:
        return 0.0
    return max(MIN_COMMISSION_PER_ORDER, COMMISSION_PER_SHARE * shares) + SLIPPAGE_PER_SHARE * shares


def run_maroy_vwap1_strategy(df, daily, all_days):
    """
    Maroy (2025) VWAP #1 adaptation using the paper's published QQQ parameters,
    applied here to SPY on our Alpaca 1-minute data.

    Published parameters (Table 10):
      lookback=2, VM enter=1.03, target vol=1.3%, start=12 min,
      trade frequency=45 min, exit 13 min before close.

    Maroy's framework used 1-second bars, relevant high/low prices, a more detailed
    IBKR fee schedule, asymmetric long/short margins, no dividend adjustment, and
    QQQ for optimization. For fair comparison in this case study we keep our common
    $0.0035/share commission + $0.001/share slippage, but retain the published
    strategy parameters and asymmetric 4x/3.33x margin mechanics.
    """
    work, dvol_map = prepare_maroy_features(df, daily)
    groups = work.groupby("day")

    out = pd.DataFrame(index=all_days)
    out.index.name = "Day"
    out["ret"] = np.nan
    out["AUM"] = np.nan
    out["orders"] = 0
    out["shares"] = np.nan
    out["leverage"] = np.nan

    current_aum = AUM_0
    trade_records = []

    for d, current_day in enumerate(all_days):
        out.loc[current_day, "AUM"] = current_aum
        if d == 0 or current_day not in groups.groups or all_days[d - 1] not in groups.groups:
            continue

        day_data = groups.get_group(current_day).copy()
        prev_data = groups.get_group(all_days[d - 1])
        maroy_dvol = dvol_map.get(current_day, np.nan)
        if not np.isfinite(maroy_dvol) or maroy_dvol <= 0 or day_data["maroy_sigma"].isna().all():
            continue

        day_start_aum = current_aum
        open_price = float(day_data["open"].iloc[0])
        prev_close = float(prev_data["close"].iloc[-1])  # Maroy explicitly does not dividend-adjust.
        sigma = day_data["maroy_sigma"].astype(float)
        ub = max(open_price, prev_close) * (1.0 + MAROY_VOL_MULT_ENTER * sigma)
        lb = min(open_price, prev_close) * (1.0 - MAROY_VOL_MULT_ENTER * sigma)

        elapsed = day_data["min_from_open"].to_numpy(dtype=float) - 1.0
        # 390-minute regular session; 13 minutes before 16:00 = elapsed minute 377 (15:47).
        cutoff_elapsed = 390 - MAROY_EXIT_BEFORE_CLOSE_MIN
        cutoff_candidates = np.where(elapsed >= cutoff_elapsed)[0]
        cutoff_i = int(cutoff_candidates[0]) if len(cutoff_candidates) else len(day_data) - 1

        decision_idx = np.where(
            (elapsed >= MAROY_START_AFTER_OPEN_MIN)
            & (elapsed < cutoff_elapsed)
            & (((elapsed - MAROY_START_AFTER_OPEN_MIN) % MAROY_TRADE_FREQ_MIN) == 0)
        )[0]
        decision_set = set(int(i) for i in decision_idx)

        position = 0
        shares = 0
        entry_price = np.nan
        entry_time = None
        entry_aum = np.nan
        first_leverage = np.nan
        daily_orders = 0
        last_shares = np.nan

        def close_position(exit_price, exit_time):
            nonlocal current_aum, position, shares, entry_price, entry_time, entry_aum, daily_orders, last_shares
            if position == 0 or shares <= 0:
                return
            gross_per_share = position * (float(exit_price) - float(entry_price))
            gross_pnl = gross_per_share * shares
            cost = _order_cost(shares)
            current_aum += gross_pnl - cost
            daily_orders += 1
            trade_records.append({
                "Strategy": MAROY_NAME,
                "Day": current_day,
                "Direction": "Long" if position > 0 else "Short",
                "Entry Time": pd.Timestamp(entry_time),
                "Exit Time": pd.Timestamp(exit_time),
                "Entry Price": float(entry_price),
                "Exit Price": float(exit_price),
                "Gross PnL / Share": gross_per_share,
                "Trade Return (%)": position * (float(exit_price) / float(entry_price) - 1.0) * 100.0,
                "Shares": shares,
            })
            last_shares = shares
            position = 0
            shares = 0
            entry_price = np.nan
            entry_time = None
            entry_aum = np.nan

        for i in range(len(day_data)):
            row = day_data.iloc[i]
            ts = day_data.index[i]

            # Fixed intraday time exit.
            if i >= cutoff_i:
                if position != 0:
                    close_position(float(row["open"]), ts)
                break

            # VWAP-only continuous stop using minute high/low to detect a touch.
            if position > 0 and float(row["low"]) <= float(row["vwap"]):
                # If bar opened below VWAP, a marketable exit would be worse than VWAP.
                exit_px = min(float(row["open"]), float(row["vwap"]))
                close_position(exit_px, ts)
            elif position < 0 and float(row["high"]) >= float(row["vwap"]):
                exit_px = max(float(row["open"]), float(row["vwap"]))
                close_position(exit_px, ts)

            # Entries only at published timing grid and only while flat.
            if position == 0 and i in decision_set and i + 1 < cutoff_i:
                sigma_i = float(sigma.iloc[i])
                if not np.isfinite(sigma_i) or sigma_i <= 0:
                    continue

                long_excess = float(row["high"]) - float(ub.iloc[i])
                short_excess = float(lb.iloc[i]) - float(row["low"])
                long_hit = long_excess > 0
                short_hit = short_excess > 0
                if not long_hit and not short_hit:
                    continue

                if long_hit and short_hit:
                    direction = 1 if long_excess >= short_excess else -1
                else:
                    direction = 1 if long_hit else -1

                # Avoid look-ahead from the decision bar: execute at NEXT minute open.
                next_row = day_data.iloc[i + 1]
                next_ts = day_data.index[i + 1]
                px = float(next_row["open"])
                if px <= 0:
                    continue

                margin_mult = MAROY_LONG_MARGIN_MULT if direction > 0 else MAROY_SHORT_MARGIN_MULT
                vol_scale = min(1.0, MAROY_TARGET_VOL / float(maroy_dvol))
                target_notional = current_aum * margin_mult * vol_scale
                new_shares = int(math.floor(target_notional / px))
                if new_shares <= 0:
                    continue

                # Entry cost is charged immediately; slippage is represented as explicit per-share cost.
                current_aum -= _order_cost(new_shares)
                daily_orders += 1
                position = direction
                shares = new_shares
                entry_price = px
                entry_time = next_ts
                entry_aum = current_aum
                last_shares = shares
                if not np.isfinite(first_leverage):
                    first_leverage = target_notional / max(day_start_aum, 1e-12)

        # Safety exit for short/irregular sessions where the cutoff bar is unavailable.
        if position != 0:
            close_position(float(day_data["close"].iloc[-1]), day_data.index[-1])

        daily_ret = (current_aum / day_start_aum - 1.0) if day_start_aum != 0 else np.nan
        out.loc[current_day, "ret"] = daily_ret
        out.loc[current_day, "AUM"] = current_aum
        out.loc[current_day, "orders"] = daily_orders
        out.loc[current_day, "shares"] = last_shares
        out.loc[current_day, "leverage"] = first_leverage

    return out, pd.DataFrame(trade_records)


