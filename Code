def prepare_features(spy_intra_data, spy_daily_data, dividends):
    df = spy_intra_data.copy()
    df["caldt"] = pd.to_datetime(df["caldt"])
    df["day"] = df["caldt"].dt.date
    df = df.set_index("caldt").sort_index()

    all_days = np.array(sorted(df["day"].unique()))

    df["move_open"] = np.nan
    df["vwap"] = np.nan
    df["spy_dvol"] = np.nan

    spy_ret = pd.Series(index=all_days, dtype=float)

    groups = df.groupby("day")

    # VWAP and move-from-open are available for every trading day.
    for d, current_day in enumerate(all_days):
        day_data = groups.get_group(current_day)
        hlc = (day_data["high"] + day_data["low"] + day_data["close"]) / 3.0
        cum_vol_x_hlc = (day_data["volume"] * hlc).cumsum()
        cum_volume = day_data["volume"].cumsum()
        df.loc[day_data.index, "vwap"] = cum_vol_x_hlc / cum_volume

        open_price = day_data["open"].iloc[0]
        df.loc[day_data.index, "move_open"] = (day_data["close"] / open_price - 1.0).abs()

        if d > 0:
            prev_day_data = groups.get_group(all_days[d - 1])
            spy_ret.loc[current_day] = day_data["close"].iloc[-1] / prev_day_data["close"].iloc[-1] - 1.0

        # Strict paper interpretation: previous 14 completed daily returns.
        if d >= LOOKBACK_DAYS + 1:
            recent = spy_ret.iloc[d - LOOKBACK_DAYS:d].dropna()
            if len(recent) == LOOKBACK_DAYS:
                df.loc[day_data.index, "spy_dvol"] = recent.std(ddof=1)

    # 09:30 is minute 1, 09:59 is minute 30, etc.
    df["min_from_open"] = (
        (df.index - df.index.normalize()) / pd.Timedelta(minutes=1)
        - (9 * 60 + 30)
        + 1
    )
    df["minute_of_day"] = df["min_from_open"].round().astype(int)

    # Same-minute average absolute move over previous 14 days, with no look-ahead.
    minute_groups = df.groupby("minute_of_day")
    df["move_open_rolling_mean"] = minute_groups["move_open"].transform(
        lambda x: x.rolling(window=LOOKBACK_DAYS, min_periods=LOOKBACK_DAYS).mean()
    )
    df["sigma_open"] = minute_groups["move_open_rolling_mean"].transform(lambda x: x.shift(1))

    # Fast 2-day same-minute Noise Area, inspired by Maroy's finding that shorter
    # lookbacks can adapt more quickly.  This is available using PRIOR days only.
    df["sigma_fast_2"] = minute_groups["move_open"].transform(
        lambda x: x.rolling(window=2, min_periods=2).mean().shift(1)
    )
    ratio = df["sigma_fast_2"] / df["sigma_open"].replace(0, np.nan)
    ratio = ratio.replace([np.inf, -np.inf], np.nan)
    df["fast_slow_noise_ratio"] = ratio

    # Parameter-free adaptive blend: when the most recent two days differ strongly
    # from the 14-day regime, put more weight on the fast estimate.
    # w=0 when fast==slow; w approaches 1 when the regime shift is large.
    regime_score = (ratio - 1.0).abs().clip(lower=0.0, upper=1.0)
    df["noise_regime_score"] = regime_score
    df["adaptive_noise_weight"] = regime_score
    df["sigma_adaptive"] = (
        (1.0 - df["adaptive_noise_weight"]) * df["sigma_open"]
        + df["adaptive_noise_weight"] * df["sigma_fast_2"]
    )

    # Preserve datetime index while mapping current-day ex-dividend amount.
    if dividends is not None and not dividends.empty:
        div = dividends.copy()
        div["day"] = pd.to_datetime(div["caldt"]).dt.date
        div_map = div.groupby("day")["dividend"].sum().to_dict()
        df["dividend"] = df["day"].map(div_map).fillna(0.0)
    else:
        df["dividend"] = 0.0

    # Daily SPY return series for benchmark/regression.
    daily = spy_daily_data.copy()
    daily["caldt"] = pd.to_datetime(daily["caldt"])
    daily["day"] = daily["caldt"].dt.date
    daily = daily.sort_values("day").drop_duplicates("day", keep="last").set_index("day")
    daily["ret"] = daily["close"].pct_change()

    return df, daily, all_days


