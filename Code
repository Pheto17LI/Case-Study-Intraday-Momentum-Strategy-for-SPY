def daily_patterns_table(daily, dynamic_returns):
    # Paper-style pattern definitions. Patterns are formed on day t-1 and used to condition strategy return on day t.
    d = daily[["open", "high", "low", "close"]].copy().astype(float)
    d.index = pd.to_datetime(pd.Index(d.index.astype(str)))
    rng = d["high"] - d["low"]
    safe_rng = rng.replace(0, np.nan)
    open_loc = (d["open"] - d["low"]) / safe_rng
    close_loc = (d["close"] - d["low"]) / safe_rng
    avg_range14 = rng.shift(1).rolling(14, min_periods=14).mean()

    patterns = pd.DataFrame(index=d.index)
    patterns["NR4"] = rng.eq(rng.rolling(4, min_periods=4).min())
    patterns["NR7"] = rng.eq(rng.rolling(7, min_periods=7).min())
    patterns["ID"] = (d["high"] < d["high"].shift(1)) & (d["low"] > d["low"].shift(1))
    patterns["OD"] = (d["high"] > d["high"].shift(1)) & (d["low"] < d["low"].shift(1))
    patterns["Triangle"] = (d["high"] < pd.concat([d["high"].shift(1), d["high"].shift(2)], axis=1).min(axis=1)) & (d["low"] > pd.concat([d["low"].shift(1), d["low"].shift(2)], axis=1).max(axis=1))
    bullish_trend = (open_loc <= 0.15) & (close_loc >= 0.85)
    bearish_trend = (open_loc >= 0.85) & (close_loc <= 0.15)
    patterns["Trend"] = (bullish_trend | bearish_trend) & (rng > avg_range14)
    patterns["Big Tail"] = ((open_loc >= 0.75) & (close_loc >= 0.75)) | ((open_loc <= 0.25) & (close_loc <= 0.25))
    patterns["Strong/Weak Closure"] = (close_loc >= 0.90) | (close_loc <= 0.10)

    # Shift one day: the completed daily pattern is known before the next trading session.
    patterns = patterns.shift(1).fillna(False)
    r = dynamic_returns.copy()
    r.index = pd.to_datetime(pd.Index(r.index.astype(str)))
    r = r.reindex(patterns.index)

    rows = [{"Daily Pattern": "Unconditional", **stats_for_subset(r.dropna())}]
    for col in patterns.columns:
        rows.append({"Daily Pattern": col, **stats_for_subset(r[patterns[col]].dropna())})
    return pd.DataFrame(rows)


def rsi_wilder(close, period=5):
    close = pd.Series(close).astype(float)
    delta = close.diff()
    gain = delta.clip(lower=0)
    loss = -delta.clip(upper=0)
    avg_gain = gain.ewm(alpha=1/period, adjust=False, min_periods=period).mean()
    avg_loss = loss.ewm(alpha=1/period, adjust=False, min_periods=period).mean()
    rs = avg_gain / avg_loss.replace(0, np.nan)
    return 100 - 100/(1+rs)


def gamma_rsi_regression(daily, dynamic_returns):
    d = daily[["close"]].copy()
    d.index = pd.to_datetime(pd.Index(d.index.astype(str)))
    d["RSI5"] = rsi_wilder(d["close"], 5)
    r = dynamic_returns.copy()
    r.index = pd.to_datetime(pd.Index(r.index.astype(str)))
    tmp = pd.concat([r.rename("ret"), d["RSI5"].shift(1).rename("RSI5_prev")], axis=1).dropna()
    if len(tmp) < 10:
        return pd.DataFrame(), None
    y = tmp["ret"] * 10000  # bps, as in paper discussion
    X = sm.add_constant(tmp["RSI5_prev"])
    model = sm.OLS(y, X).fit()
    out = pd.DataFrame([{ 
        "Observations": int(model.nobs),
        "Alpha (bps)": model.params.get("const", np.nan),
        "Beta RSI5": model.params.get("RSI5_prev", np.nan),
        "Beta p-value": model.pvalues.get("RSI5_prev", np.nan),
        "R-squared": model.rsquared,
    }])
    return out, (tmp, model)


